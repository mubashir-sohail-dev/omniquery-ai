# ==============================================================================
# OmniQuery AI — Enterprise Hybrid Text-to-SQL Assistant Configuration
# ==============================================================================

# Groq API Key (Required for Llama 3.1 & Llama 3.3 LLM generation)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model Selection
FAST_MODEL=llama-3.1-8b-instant
SMART_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# Microsoft SQL Server Database Configuration
# ==============================================================================
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=AdventureWorks2025
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# (Optional) SQL Server SQL Authentication (if not using Trusted_Connection/Windows Auth)
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password

# ==============================================================================
# Offline / Mock Mode Toggle
# Set to 'true' to run demo queries without an active MS SQL Server instance
# ==============================================================================
MOCK_MODE=false
